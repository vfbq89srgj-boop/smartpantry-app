# Copy this file to ".env" and fill in the values.
# All VITE_ values end up inside the app and are public:
# NEVER put the database password or the service_role key here.

# Address of Benny's API (no trailing /). Empty = demo mode with sample data.
# Running the backend locally with "dotnet run": http://localhost:5286
VITE_API_URL=

# Supabase project URL and publishable key (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
